{
  "expo": {
    "name": "Kanev Pharmacy",
    "slug": "kanev-pharmacy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "kanevpharmacy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "zm.kanevpharmacy.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "zm.kanevpharmacy.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F8F5"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Kanev Pharmacy",
      "shortName": "Kanev",
      "themeColor": "#0B4B36",
      "backgroundColor": "#F4F8F5"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Kanev Pharmacy to share your location while you are delivering orders, including when the app is in the background.",
          "locationWhenInUsePermission": "Allow Kanev Pharmacy to access your location during deliveries.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}
